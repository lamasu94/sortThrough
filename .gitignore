# ── Environment variables ────────────────────────────
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# ── Dependencies ──────────────────────────────────────
backend/node_modules/
frontend/node_modules/

# ── Uploaded files (keep the folders, ignore their contents) ──
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/products/.gitkeep
!backend/uploads/avatars/.gitkeep

# ── Next.js build output ─────────────────────────────
frontend/.next/
frontend/out/

# ── Logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── OS / editor junk ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/